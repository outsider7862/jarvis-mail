# Postgres connection string (asyncpg driver)
# Example (Supabase): postgresql+asyncpg://postgres:[email protected]:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/leadpilot

# Composio
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_WEBHOOK_SECRET=your_composio_webhook_secret_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EXTRACTION_MODEL=gpt-5.5

# Supabase Auth — find this in your Supabase project: Settings -> API -> Project URL
# We verify login tokens against Supabase's public JWKS endpoint (built from this
# URL), so no secret needs to live here at all — only the project URL, which is
# not sensitive.
SUPABASE_URL=https://your-project-ref.supabase.co

APP_ENV=development
