# Postgres connection string (asyncpg driver)
# Example (Supabase): postgresql+asyncpg://postgres:[email protected]:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/leadpilot

# Composio
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_WEBHOOK_SECRET=your_composio_webhook_secret_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EXTRACTION_MODEL=gpt-5.5

# Supabase Auth — find this in your Supabase project: Settings -> API -> JWT Secret
# This is what verifies the login tokens sent by the dashboard/Android app.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

APP_ENV=development
